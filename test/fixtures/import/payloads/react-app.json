  "source": {
    "html": "<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<title>React fixture</title>\n<!--\n  A React app in development, for the capture's React annotations: which\n  component drew each element. Loaded from Scamp's own node_modules, so\n  the fixture needs nothing installed. see docs/plans/react-import-plan.md\n-->\n<style>\n  body { margin: 0; font: 14px/20px system-ui, sans-serif; }\n  .shell { display: flex; }\n  .nav { display: flex; flex-direction: column; width: 200px; }\n  .main { flex: 1; padding: 16px; }\n  .card { padding: 12px; border: 1px solid #ccc; margin-bottom: 8px; }\n</style>\n<script src=\"../../../../node_modules/react/umd/react.development.js\"></script>\n<script src=\"../../../../node_modules/react-dom/umd/react-dom.development.js\"></script>\n</head>\n<body>\n<div id=\"root\"><div class=\"shell\"><nav class=\"nav\"><button class=\"nav-item\">Home</button><button class=\"nav-item\">About</button></nav><main class=\"main\"><section class=\"card\"><h2>First</h2><p>Body</p></section><section class=\"card\"><h2>Second</h2><p>Body</p></section></main></div></div>\n<script>\n  const h = React.createElement;\n  function NavItem({ label }) { return h('button', { className: 'nav-item' }, label); }\n  function Card({ title }) { return h('section', { className: 'card' }, h('h2', null, title), h('p', null, 'Body')); }\n  function Shell({ children }) {\n    return h('div', { className: 'shell' },\n      h('nav', { className: 'nav' }, h(NavItem, { label: 'Home' }), h(NavItem, { label: 'About' })),\n      h('main', { className: 'main' }, children));\n  }\n  function App() { return h(Shell, null, h(Card, { title: 'First' }), h(Card, { title: 'Second' })); }\n  ReactDOM.createRoot(document.getElementById('root')).render(h(App));\n</script>\n\n\n</body></html>",
    "css": "/* <style> */\nbody { margin: 0px; font: 14px / 20px system-ui, sans-serif; }\n.shell { display: flex; }\n.nav { display: flex; flex-direction: column; width: 200px; }\n.main { flex: 1 1 0%; padding: 16px; }\n.card { padding: 12px; border: 1px solid rgb(204, 204, 204); margin-bottom: 8px; }",
