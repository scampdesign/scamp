{
  "name": "scamp",
  "version": "0.8.8",
  "description": "Local-first design tool. Draw, get real TSX + CSS.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Angie Hemans",
    "email": "angie@scampdesign.app"
  },
  "homepage": "https://github.com/scampdesign/scamp",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "patch-package && electron-rebuild -f -w node-pty",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "shims:web": "tsc --build tsconfig.web.json --force",
    "shims:node": "tsc --build tsconfig.node.json --force",
    "shims": "npm run shims:web && npm run shims:node",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration/",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:nobuild": "playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "package": "npm run build && electron-builder --config electron-builder.yml",
    "verify:feed": "node scripts/verify-update-feed.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@sentry/electron": "^7.17.0",
    "@tabler/icons-react": "^3.41.1",
    "@uiw/react-codemirror": "^4.25.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^3.6.0",
    "culori": "^4.0.2",
    "dompurify": "^3.4.11",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "html-to-image": "^1.11.13",
    "htmlparser2": "^12.0.0",
    "node-pty": "^1.1.0",
    "postcss": "^8.5.9",
    "react-colorful": "^5.7.0",
    "sharp": "^0.35.3",
    "zundo": "^2.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/culori": "^4.0.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "preact": "^10.29.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "scampjs": "^0.3.0",
    "typescript": "^5.4.5",
    "vite": "^7.3.1",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "node-abi": "^4.35.0"
  }
}
